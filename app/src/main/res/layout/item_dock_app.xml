<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dock_item_root"
    android:layout_width="@dimen/dock_item_size"
    android:layout_height="@dimen/dock_item_size"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_glass_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center">

    <ImageView
        android:id="@+id/dock_app_icon"
        android:layout_width="@dimen/dock_icon_size"
        android:layout_height="@dimen/dock_icon_size"
        android:contentDescription="@string/dock_title"
        android:scaleType="fitCenter" />

</LinearLayout>
